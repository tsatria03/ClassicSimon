#pragma asset sounds
#pragma document docks

#include"instance.nvgt"
#include"sound_pool.nvgt"
#include"speech.nvgt"
#include"includes/*.nvgt"

bool autopilot = false;
bool simspeech=false;
array<int> sequence;
int player_index;
int play_delay;
int input_timeout;
int base_play_delay = 500;
int base_input_timeout = 2000;
int difmod=1;
string loaded_pack = "";
string simontype = "";
string version="1.0";
sound fail_sound;
sound[] tone_sounds(4);
sound_pool temp;
custom_menu m;
instance gamstance("csm");
timer input_timer;
void main()
{
    show_window("ClassicSimon, version "+version);
if(gamstance.is_already_running)
{
alert("error", "You can only have one instance of this game running!");
exit();
}
else
{
wait(500);
speak("KMK productions presents, ClassicSimon! Press enter to continue.");
dlgplay("sounds/misc/logo.ogg");
    mainmenu();
    }
}
