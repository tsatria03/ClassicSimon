#include"includes/includes.nvgt"
void main()
{
    show_window("ClassicSimon, version "+version);
if(gamstance.is_already_running)
{
alert("error", "You can only have one instance of this game running!");
exit();
}
else
{
wait(500);
speak("KMK and Tsatria03 productions presents, ClassicSimon! Press enter to continue.");
dlgplay("sounds/misc/logo.ogg");
    mainmenu();
    }
}
