void mainmenu()
{
    while(true)
    {
        setupmenu(true);
        m.add_item("Play", "play");
        m.add_item("Settings", "settings");
        m.add_item("Exit", "exit");
        m.intro_text = "Main menu. Choose an option with your arrow keys, then press enter to activate one.";
        int res = m.run();
        string main = m.get_item_id(res);
        if(res == -1)
        {
            speak("Exiting");
            m.fade_music();
            exit();
        }
        if(main == "play")
        {
            packmenu();
            continue;
        }
        if(main == "settings")
        {
m.fade_music();
            settingsmenu();
            continue;
        }
        if(main == "exit")
        {
            speak("Exiting");
            m.fade_music();
            exit();
        }
    }
}
void settingsmenu()
{
    int focus = 0;
    while(true)
    {
        setupmenu(false);
        m.add_item("Play logo at startup, currently " + (logoplay ? "on" : "off"), "logo");
        m.add_item("Spoken hints, currently " + (simspeech ? "on" : "off"), "hints");
        m.add_item("Back", "back");
        m.intro_text = "Settings menu.";
        int res = m.run(focus, true, true);
        string setid = m.get_item_id(res);
        if(res == -1 || setid == "back")
        {
            speak("canceled");
            return;
        }
        focus = res - 1;
        if(setid == "logo")
            logoplay = !logoplay;
        if(setid == "hints")
            simspeech = !simspeech;
        writepreffs();
    }
}
void packmenu()
{
    while(true)
    {
        setupmenu(true);
        string[] packs = find_directories("sounds/simons/*");
        if(packs.length() == 0)
        {
            speak("No Simon packs found.");
            return;
        }
        for(uint i = 0; i < packs.length(); i++)
        {
            m.add_item(packs[i], packs[i]);
        }
        m.add_item("Back", "back");
        m.intro_text = "Choose a Simon pack.";
        int res = m.run();
        string packid = m.get_item_id(res);
        if(res == -1)
            return;
        if(packid == "back")
            return;
        simontype = packid;
        pack_options_menu();
    }
}
void pack_options_menu()
{
    while(true)
    {
        setupmenu(true);
        m.add_item("Start game", "start");
        m.add_item("Learn tones", "learn");
        m.add_item("View scores", "scores");
        m.add_item("Back", "back");
        m.intro_text = simontype + " loaded. What would you like to do?";
        int res = m.run();
        string gamid = m.get_item_id(res);
        if(res == -1)
            return;
        if(gamid == "back")
            return;
        if(gamid == "start")
        {
modemenu();
            continue;
        }
        if(gamid == "learn")
        {
m.fade_music();
            learnsounds();
            continue;
        }
        if(gamid == "scores")
        {
            viewscores();
            continue;
        }
    }
}
void viewscores()
{
    int focus = 0;
    sc.load();
    while(true)
    {
        setupmenu(true);
        m.add_item(score_line("Easy", simontype, 1), "easy");
        m.add_item(score_line("Medium", simontype, 2), "medium");
        m.add_item(score_line("Hard", simontype, 3), "hard");
        m.add_item("Back", "back");
        m.intro_text = simontype + " scores.";
        int res = m.run(focus, true, true);
        string id = m.get_item_id(res);
        if(res == -1 || id == "back")
        {
            speak("canceled");
            return;
        }
        focus = res - 1;
    }
}
void modemenu()
{
    while(true)
    {
        setupmenu(true);
        m.add_item("easy", "dif1");
        m.add_item("medium", "dif2");
        m.add_item("hard", "dif3");
        m.add_item("back", "back");
        m.intro_text = "Choose a game difficulty.";
        int res = m.run();
        string difid = m.get_item_id(res);
        if(res == -1 || difid == "back")
        {
            return;
        }
        if(difid == "dif1") difmod = 1;
        if(difid == "dif2") difmod = 2;
        if(difid == "dif3") difmod = 3;
        setupmenu(true);
        m.add_item("Yes", "auto");
        m.add_item("No", "manual");
        m.intro_text = "Would you like to enable autopilot for this game?";
        int ares = m.run(0, true, true);
        string aid = m.get_item_id(ares);
        if(ares == -1)
        {
            continue;
        }
        if(aid == "manual")
            autopilot = false;
        if(aid == "auto")
            autopilot = true;
m.fade_music();
        play_game();
    }
}
